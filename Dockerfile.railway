# Single-container build for Railway/Render: builds assets, then serves
# Laravel with nginx + php-fpm (+ queue worker) on $PORT.
FROM node:20-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM php:8.3-fpm
RUN apt-get update && apt-get install -y \
    nginx gettext-base git curl zip unzip \
    libpng-dev libonig-dev libxml2-dev libzip-dev libfreetype6-dev \
    libjpeg62-turbo-dev libwebp-dev libicu-dev libpq-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) bcmath exif gd intl mbstring opcache pcntl pdo pdo_pgsql pgsql posix xml zip
RUN printf "upload_max_filesize=100M\npost_max_size=100M\nmemory_limit=512M\nmax_execution_time=120\n" > /usr/local/etc/php/conf.d/uploads.ini \
    && printf "opcache.enable=1\nopcache.memory_consumption=128\n" > /usr/local/etc/php/conf.d/opcache.ini
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY . .
COPY --from=assets /app/public/build ./public/build
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress \
    && mkdir -p storage/framework/{cache,sessions,views} storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache && chmod -R 775 storage bootstrap/cache
COPY deploy/railway/nginx.conf.template /etc/nginx/nginx.conf.template
COPY deploy/railway/start.sh /start.sh
RUN chmod +x /start.sh
CMD ["/start.sh"]
